    {
      "dot": "cyan",
      "title": "框架定位对比",
      "items": [
        "PyTorch: 动态图直观, 科研论文首选, 生态 HuggingFace",
        "TensorFlow: Keras 高层 API, 生产部署体系最成熟 (TF Serving)",
        "PaddlePaddle: 国产框架, 中文文档与模型库丰富, 信创适配",
        "JAX: 函数式 + 即时编译, 科研前沿, 适合自定义研究",
        "其他: MindSpore (华为全场景), MXNet (已停止维护)"
      ]
    },
    {
      "dot": "emerald",
      "title": "全流程共性: 五阶段对所有框架一致",
      "items": [
        "数据准备 → 模型定义 → 训练评估 → 导出转换 → 部署服务",
        "你学会的 PyTorch 流程, 换框架只是换 API 名称",
        "图中每一行就是一个完整 pipeline (与本项目实战同构)",
        "ONNX 是跨框架通用交换格式: 任意框架训练, 统一部署"
      ]
    },
    {
      "dot": "amber",
      "title": "选型建议",
      "items": [
        "科研 / 快速原型: PyTorch 或 JAX",
        "工业大规模部署: TensorFlow + TF Serving",
        "国内业务 / 信创环境: PaddlePaddle 或 MindSpore",
        "跨框架部署: 训练任选, 导出 ONNX + ONNX Runtime 通用"
      ]
    }
