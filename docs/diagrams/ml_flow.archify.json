  "cards": [
    {
      "dot": "cyan",
      "title": "企业级 ML 流程五阶段",
      "items": [
        "数据工程 → 模型训练 → 评估导出 → 服务化 → 打包交付",
        "每个阶段有明确产出物: 数据集 / 权重 / ONNX / API / exe",
        "阶段间设门禁: 测试集达标才允许导出部署",
        "数据、代码、模型、部署配置全部纳入版本管理"
      ]
    },
    {
      "dot": "emerald",
      "title": "本次实战落地清单",
      "items": [
        "数据: MNIST raw → processed (torchvision)",
        "训练: model.py + mnist_train.py → mnist_cnn.pth",
        "评估: 测试集 99.13%, 训练/测试差距 0.4% 无过拟合",
        "服务: serve.py + onnxruntime + /api/predict",
        "交付: MNIST识别服务.exe 单文件, 对方零依赖"
      ]
    },
    {
      "dot": "amber",
      "title": "关键知识点",
      "items": [
        "置信度 ≠ 正确率: 84% 置信度也会认错数字",
        "输入必须与训练分布一致: 反色/笔画粗细/透明通道",
        "预处理管线占实战 60~80% 工作量",
        "ONNX 一次导出, Python/JS/Java/浏览器多平台复用"
      ]
    }
  ]
