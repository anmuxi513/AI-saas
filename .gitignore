*.pth
*.onnx
projects/*/models/

# ---- 对话模型缓存（HuggingFace 权重约 1GB）----
projects/chat/models/

# ---- PyInstaller 产物 ----
dist/
build/
*.spec

# ---- 第三方 skill 仓库（独立维护，见 README）----
skills/

# ---- 前端构建产物与缓存 ----
frontend/node_modules/
frontend/dist/
frontend/.npm-cache/
.npm-cache/
